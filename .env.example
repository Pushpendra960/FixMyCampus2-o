# GEMINI_API_KEY: Required for server-side Gemini AI issue classification.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (injected in AI Studio / Cloud Run).
APP_URL="MY_APP_URL"

# PORT: HTTP server port (defaults to 3000; set automatically by cloud hosts).
PORT=3000

# CORS_ORIGIN: Optional comma-separated list of allowed browser origins for cross-origin deployments.
CORS_ORIGIN=
